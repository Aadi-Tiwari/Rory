  "protocol_citations": [
    {"citation_id": "C_REGS_405_4_1", "source": "rorys_regs", "section": "§405.4.1", "page": 3, "quote": "Every pediatric patient presenting to the emergency department shall be screened for sepsis using age-appropriate vital sign thresholds and clinical criteria.", "pdf_url": "/pdfs/rorys_regs.pdf#page=3"},
    {"citation_id": "C_REGS_405_4_2", "source": "rorys_regs", "section": "§405.4.2", "page": 4, "quote": "Pediatric-specific vital sign thresholds shall be applied per PALS reference ranges, with age-adjusted criteria for tachycardia, tachypnea, and hypotension.", "pdf_url": "/pdfs/rorys_regs.pdf#page=4"},
    {"citation_id": "C_REGS_405_4_3", "source": "rorys_regs", "section": "§405.4.3", "page": 5, "quote": "Patients re-presenting to the emergency department within 72 hours of discharge shall receive heightened screening and mandatory physician re-evaluation prior to any subsequent discharge.", "pdf_url": "/pdfs/rorys_regs.pdf#page=5"},
    {"citation_id": "C_REGS_405_4_5", "source": "rorys_regs", "section": "§405.4.5", "page": 7, "quote": "Any patient triggering the sepsis screen shall not be discharged without direct physician evaluation and documentation of the reasoning for discharge.", "pdf_url": "/pdfs/rorys_regs.pdf#page=7"},
    {"citation_id": "C_PSSC_3_4", "source": "pediatric_ssc", "section": "§3.4", "page": 12, "quote": "School-age pediatric patients (6-12 years) with sustained heart rate above 120 bpm in the absence of fever source warrant sepsis screening.", "pdf_url": "/pdfs/pediatric_ssc.pdf#page=12"},
    {"citation_id": "C_PSSC_5_2", "source": "pediatric_ssc", "section": "§5.2", "page": 22, "quote": "The combination of fever and documented wound source in a pediatric patient is a high-suspicion pattern for invasive bacterial infection and requires mandatory workup.", "pdf_url": "/pdfs/pediatric_ssc.pdf#page=22"},
    {"citation_id": "C_PSSC_6_1", "source": "pediatric_ssc", "section": "§6.1", "page": 28, "quote": "Altered mental status in a febrile pediatric patient - including language such as 'confused,' 'won't make eye contact,' or 'not acting right' - shall be considered a qSOFA-equivalent criterion.", "pdf_url": "/pdfs/pediatric_ssc.pdf#page=28"},
    {"citation_id": "C_PALS_3_4", "source": "pals", "section": "§3.4", "page": 15, "quote": "School-age children (6-12 years): normal HR 70-120, normal RR 18-30.", "pdf_url": "/pdfs/pals_reference.pdf#page=15"}
  ],
